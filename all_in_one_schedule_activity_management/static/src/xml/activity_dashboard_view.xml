    <t t-name="ActivityTable">
        <div class="table_today_activity">
            <t t-if="manage_activities.planned_activity">
                <table cellspacing="10" width="100%"
                       style="padding: 24px; background-color: white; color: #454748; border-collapse:separate;">
                    <thead>
                        <tr>
                            <th>Planned Activities</th>
                        </tr>
                        <t t-if="manage_activities.planned_activity == ''">
                            <td>No Data Available</td>
                        </t>
                    </thead>
                    <t t-if="manage_activities.planned_activity != ''">
                        <thead class="table table-bordered mt32">
                            <tr class="table_head">
                                <th class="table_head_">Name</th>
                                <th class="table_head_">Activity Type</th>
                                <th class="table_head_">Assigned to</th>
                                <th class="table_head_">Due Date</th> <!-- Added Due Date -->
                                <th class="table_head_">State</th> <!-- Added State -->
                                <th class="table_head_">Created On</th> <!-- Added Created On -->
                                <th class="table_head_">Modified On</th> <!-- Added Modified On -->
                                <th class="table_head_">Origin</th> 
                                <th class="table_head_">Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="manage_activities.planned_activity"
                                t-as="line" t-key="line['id']">
                                <td>
                            <t t-esc="line['display_name']"/>
                        </td>
                        <td>
                            <t t-esc="line['activity_type_id']['1']"/>
                        </td>
                        <td>
                            <t t-esc="line['user_id']['1']"/>
                        </td>
                        <td>
                            <t t-esc="line['due_date']"/> <!-- Display Due Date -->
                        </td>
                        <td>
                            <t t-esc="line['state']"/> <!-- Display State -->
                        </td>
                        <td>
                            <t t-esc="line['create_date']"/> <!-- Display Created On -->
                        </td>
                        <td>
                            <t t-esc="line['write_date']"/> <!-- Display Modified On -->
                        </td>
                        <!-- <td> -->
                            <!-- <t t-esc="line['source_name']"/> Display Source Name -->
                        <!-- </td> -->

                        <td class="cursor-pointer"
                                    t-on-click="click_origin_view"
                                    t-att-data-id="line.id">

                                    <div class="d-flex align-items-center ps-2 rounded">
                                        <!-- <i class="fa fa-pencil me-1 pe-none"/> -->
                                        <!-- <span class="pe-none">Origin</span> -->
                                        <t t-if="line.origin_name">
                                            <span class="pe-none" t-esc="line.origin_name"/>
                                        </t>
                                    </div>
                                </td>

                                <td class="cursor-pointer"
                            t-on-click="click_view"
                            t-att-data-id="line.id">

                            <div class="d-flex align-items-center ps-2 rounded">
                                <i class="fa fa-pencil me-1 pe-none"/>
                                <span class="pe-none">Edit</span>
                            </div>

                        </td>
                                
                            </tr>
                        </tbody>
                    </t>
                </table>
            </t>
        </div>

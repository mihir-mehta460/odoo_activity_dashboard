<?xml version="1.0" encoding="utf-8"?>
<!-- This XML code creates the dashboard for the mail.activity. -->
<templates>
    <t t-name="ActivityDashboard">
        
            <!-- Dashboard Title -->
            <div class="header_section">
            <h1 class="dashboard_heading">Activity Dashboard</h1>
            <div class="header_line"></div> 
        </div>
        <div class="activity_dashboard d-flex" style="min-height: 100vh;">
            <!-- Sidebar Section for Filters -->
            <div class="o_sidebar">
                <div class="o_section">
                    <h3>Filters</h3>

                    <!-- Filter by Activity Type -->
                    <h3>Activity Type</h3>
                    <ul class="o_list_filters">
                        <!-- All -->
                        <li>
                            <a href="#" t-on-click="() => filter_activity_type(false)">
                                All
                            </a>
                        </li>

                        <!-- Dynamic activity types from DB -->
                        <t t-if="activity_types">
                            <t t-foreach="activity_types" t-as="type" t-key="type.id">
                                <li>
                                    <a href="#" t-on-click="() => filter_activity_type(type.id)">
                                        <t t-esc="type.name"/>
                                    </a>
                                </li>
                            </t>
                        </t>
                    </ul>
                </div>

                <!-- Filter by Assigned To (Dynamically Generated List) -->
                <div class="o_section">
                    <h4>Assigned To</h4>
                    <ul class="o_list_filters">
                        <li><a href="#" t-on-click="() => filter_assigned_to('All')">All</a></li>
                        <t t-if="users.length">
                            <t t-foreach="users" t-as="user" t-key="user.id">
                                <li><a href="#" t-on-click="() => filter_assigned_to(user.id)">
                                        <t t-esc="user.name"/></a></li>
                            </t>
                        </t>
                    </ul>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="o_content">
                <!-- Displaying the Manage Activity Section -->
                <div class="table_view">
                    <t t-call="ManageActivity"/>
                </div>

                <br/>
                <!-- Displaying the Activity Table Section -->
                <div class="table_view_activity">
                    <t t-call="ActivityTable"/>
                </div>
            </div>
        </div>
    </t>
